          "stringUnit": {
            "state": "translated",
            "value": "iPhone sent an unreadable reply"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone прислал нечитаемый ответ"
          }
        }
      }
    },
    "tandem.error.noAddress": {
      "extractionState": "manual",
      "comment": "MonitorError.noAddress: --direct-only with an empty address book; no network address is known for the phone.",
