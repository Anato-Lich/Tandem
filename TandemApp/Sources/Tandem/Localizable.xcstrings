{
  "sourceLanguage": "en",
  "strings": {
    "%@ cycles": {
      "comment": "Summary window, tabbed layout: a fractional cycle estimate for today, as in \"0.90 cycles\". The number is a decimal, so this is not a plural.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cycles"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ цикла"
          }
        }
      }
    },
    "%lld cycles": {
      "comment": "Summary window, tabbed layout: the gauge's cycle count in the battery-health sub-line, as in \"33 cycles\".",
