          "stringUnit": {
            "state": "translated",
            "value": "Отменено"
          }
        }
      }
    },
    "tandem.error.macReadFailed": {
      "extractionState": "manual",
      "comment": "MonitorError.macReadFailed: the Mac's own IOKit battery read failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery read failed"
          }
