        }
      }
    },
    "Charged to 80 %% in %1$@ · %2$@": {
      "comment": "Notification body, as in \"Charged to 80 % in 23 min · 36/45 W\". %1$@ is how long the charge has been running, %2$@ is watts in over the adapter's rating. The percent sign is doubled because this goes through String(format:).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged to 80 %% in %1$@ · %2$@"
